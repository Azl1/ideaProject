<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.cardfxspring.controllers.usercontroller.ListUserController">

    <children>
        <ListView fx:id="listViewUser" layoutY="45.0" prefHeight="246.0" prefWidth="601.0" />
        <Button layoutY="302.0" mnemonicParsing="false" onAction="#addButtonU" prefHeight="42.0" prefWidth="346.0" text="Добавить пользователя" />
        <Button layoutX="350.0" layoutY="302.0" mnemonicParsing="false" onAction="#updateButtonU" prefHeight="91.0" prefWidth="126.0" text="Изменить пользователя" />
        <Button layoutX="476.0" layoutY="302.0" mnemonicParsing="false" onAction="#removeButtonU" prefHeight="91.0" prefWidth="118.0" text="Удалить  пользователя" />
        <Label fx:id="labelUsers" layoutX="29.0" layoutY="14.0" prefHeight="25.0" prefWidth="216.0" text="Список пользователей" />
        <Button layoutY="348.0" mnemonicParsing="false" onAction="#buttonShowCategory" prefHeight="42.0" prefWidth="346.0" text="Открыть выбранного  пользователя у которого есть категория" />
    </children>

</AnchorPane>
