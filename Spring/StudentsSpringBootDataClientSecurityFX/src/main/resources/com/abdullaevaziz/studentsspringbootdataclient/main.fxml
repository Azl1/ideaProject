<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.studentsspringbootdataclient.controllers.MainController">
   <children>
      <ListView fx:id="listViewStudent" layoutY="45.0" prefHeight="212.0" prefWidth="602.0" />
      <Button layoutY="259.0" mnemonicParsing="false" onAction="#addButtonS" prefHeight="42.0" prefWidth="346.0" text="Добавить студента" />
      <Button layoutX="346.0" layoutY="259.0" mnemonicParsing="false" onAction="#updateButtonS" prefHeight="133.0" prefWidth="126.0" text="Изменить студента" />
      <Button layoutX="472.0" layoutY="259.0" mnemonicParsing="false" onAction="#removeButtonS" prefHeight="134.0" prefWidth="118.0" text="Удалить  студента" />
      <Label fx:id="labelStudents" layoutX="29.0" layoutY="14.0" prefHeight="25.0" prefWidth="216.0" text="Список студентов" />
      <Button layoutY="305.0" mnemonicParsing="false" onAction="#buttonShowCars" prefHeight="42.0" prefWidth="346.0" text="Открыть выбранного студента у которого есть автомобиль" />
      <Button layoutY="350.0" mnemonicParsing="false" onAction="#buttonExit" prefHeight="42.0" prefWidth="346.0" text="Выход из аккаунта" />
   </children>
</AnchorPane>
