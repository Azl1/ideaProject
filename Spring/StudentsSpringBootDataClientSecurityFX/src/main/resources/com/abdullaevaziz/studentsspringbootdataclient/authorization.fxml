<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.abdullaevaziz.studentsspringbootdataclient.controllers.AuthorizationController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Button layoutX="190.0" layoutY="219.0" mnemonicParsing="false" onAction="#buttonLogin" prefHeight="70.0"
                prefWidth="246.0" text="Войти"/>
        <Label fx:id="labelUsers" layoutX="190.0" layoutY="59.0" prefHeight="26.0" prefWidth="246.0" text="Login"/>
        <Label fx:id="labelUsers1" layoutX="190.0" layoutY="135.0" prefHeight="26.0" prefWidth="246.0" text="Password"/>
        <TextField fx:id="loginTextField" layoutX="189.0" layoutY="91.0" prefHeight="36.0" prefWidth="246.0"/>
        <TextField fx:id="passwordTextField" layoutX="190.0" layoutY="160.0" prefHeight="36.0" prefWidth="246.0"/>
        <Button layoutX="191.0" layoutY="299.0" mnemonicParsing="false" onAction="#buttonRegUser" prefHeight="70.0"
                prefWidth="246.0" text="Нажмите чтобы зарегистрироваться" wrapText="true"/>
    </children>


</AnchorPane>
