      <TextField fx:id="textFiledLogin" layoutX="102.0" layoutY="74.0" />
      <Label layoutX="14.0" layoutY="225.0" prefHeight="24.0" prefWidth="88.0" text="Пароль" />
      <TextField fx:id="textFiledPassword" layoutX="102.0" layoutY="224.0" />
      <Label layoutX="14.0" layoutY="37.0" prefHeight="24.0" prefWidth="88.0" text="ID" />
      <TextField fx:id="textFiledID" disable="true" layoutX="102.0" layoutY="36.0" />
      <Button layoutX="282.0" layoutY="321.0" mnemonicParsing="false" onAction="#buttonExit" prefHeight="64.0" prefWidth="298.0" text="Выйти в главное меню" />
