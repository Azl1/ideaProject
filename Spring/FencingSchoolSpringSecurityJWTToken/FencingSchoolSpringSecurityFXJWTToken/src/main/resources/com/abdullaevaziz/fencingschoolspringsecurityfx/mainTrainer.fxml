<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.fencingschoolspringsecurityfx.controllers.MainTrainerController">
   <children>
      <Label layoutX="14.0" layoutY="114.0" prefHeight="24.0" prefWidth="88.0" text="Фамилия" />
      <TextField fx:id="textFiledFirstName" layoutX="102.0" layoutY="113.0" />
