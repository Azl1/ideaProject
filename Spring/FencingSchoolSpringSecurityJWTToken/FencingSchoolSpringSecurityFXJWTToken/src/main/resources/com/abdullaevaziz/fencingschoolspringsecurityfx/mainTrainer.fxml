      <TextField fx:id="textFiledName" layoutX="102.0" layoutY="149.0" />
      <Label layoutX="14.0" layoutY="188.0" prefHeight="24.0" prefWidth="88.0" text="Отчество" />
      <TextField fx:id="textFiledPatronymic" layoutX="102.0" layoutY="187.0" />
