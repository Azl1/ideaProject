<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.fencingschoolfx.controllers.TrainerController">
   <children>
      <Label layoutX="14.0" layoutY="77.0" prefHeight="24.0" prefWidth="88.0" text="Фамилия" />
      <TextField fx:id="textFiledFirstName" layoutX="102.0" layoutY="76.0" />
      <Label layoutX="14.0" layoutY="113.0" prefHeight="24.0" prefWidth="88.0" text="Имя" />
      <TextField fx:id="textFiledName" layoutX="102.0" layoutY="112.0" />
      <Label layoutX="14.0" layoutY="151.0" prefHeight="24.0" prefWidth="88.0" text="Отчество" />
      <TextField fx:id="textFiledPatronymic" layoutX="102.0" layoutY="150.0" />
      <Label layoutX="14.0" layoutY="188.0" prefHeight="24.0" prefWidth="88.0" text="Опыт работы" />
      <TextField fx:id="textFiledExperience" layoutX="102.0" layoutY="187.0" />
      <Label layoutX="365.0" layoutY="37.0" prefHeight="24.0" prefWidth="150.0" text="Расписание тренера" />
      <Button layoutX="13.0" layoutY="239.0" mnemonicParsing="false" onAction="#buttonUpdateTrainer" prefHeight="26.0" prefWidth="239.0" text="Обновить тренера" />
