      <TableView fx:id="scheduleTable" layoutX="264.0" layoutY="75.0" prefHeight="200.0" prefWidth="331.0">
          <columns>
              <TableColumn fx:id="dayColumn" prefWidth="110" text="День недели" />
              <TableColumn fx:id="startTimeColumn" prefWidth="110" text="Начало работы" />
              <TableColumn fx:id="endTimeColumn" prefWidth="110" text="Конец работы" />
          </columns>
      </TableView>
   </children>
</AnchorPane>
