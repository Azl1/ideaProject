<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.cardfx.controllers.MainController">

    <ListView fx:id="listViewCategory" layoutX="1.0" layoutY="63.0" prefHeight="273.0" prefWidth="600.0" />
    <Label fx:id="labelCategory" layoutX="3.0" layoutY="2.0" prefHeight="51.0" prefWidth="229.0" text="Список категорий у пользователей" />
    <Button layoutX="5.0" layoutY="352.0" mnemonicParsing="false" onAction="#addButtonCategory" prefHeight="25.0" prefWidth="141.0" text="Добавить категорию" />
    <Button layoutX="153.0" layoutY="352.0" mnemonicParsing="false" onAction="#updateButtonCategory" prefHeight="25.0" prefWidth="133.0" text="Изменить категорию" />
    <Button layoutX="296.0" layoutY="352.0" mnemonicParsing="false" onAction="#removeButtonCategory" prefHeight="25.0" prefWidth="133.0" text="Удалить категорию " />
   <Button layoutX="438.0" layoutY="352.0" mnemonicParsing="false" onAction="#closeButton" prefHeight="25.0" prefWidth="133.0" text="Закрыть" />

</AnchorPane>
