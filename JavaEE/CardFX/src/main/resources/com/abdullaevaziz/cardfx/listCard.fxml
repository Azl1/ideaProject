<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abdullaevaziz.cardfx.controllers.cardcontrollers.ListCardController">

    <ListView fx:id="listViewCard" layoutX="1.0" layoutY="63.0" prefHeight="273.0" prefWidth="600.0" />
    <Label fx:id="labelCard" layoutX="3.0" layoutY="2.0" prefHeight="51.0" prefWidth="229.0" text="Список карточек в категорий" />
    <Button layoutX="38.0" layoutY="352.0" mnemonicParsing="false" onAction="#addButtonCard" prefHeight="25.0" prefWidth="108.0" text="Добавить" />
    <Button layoutX="169.0" layoutY="352.0" mnemonicParsing="false" onAction="#updateButtonCard" prefHeight="25.0" prefWidth="108.0" text="Изменить" />
    <Button layoutX="336.0" layoutY="352.0" mnemonicParsing="false" onAction="#removeButtonCard" prefHeight="25.0" prefWidth="108.0" text="Удалить" />
   <Button layoutX="467.0" layoutY="352.0" mnemonicParsing="false" onAction="#closeButtonCard" prefHeight="25.0" prefWidth="108.0" text="Закрыть" />

</AnchorPane>
